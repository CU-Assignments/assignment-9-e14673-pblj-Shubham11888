    private double balance;

    public Account() {}
    public Account(int accNo, String holder, double balance) {
        this.accNo = accNo;
        this.holder = holder;
        this.balance = balance;
    }

    // Getters & Setters
}
import jakarta.persistence.*;
import java.util.Date;

@Entity
public class Transaction {
    @Id
    @GeneratedValue
    private int txnId;
    private int fromAcc;
    private int toAcc;
    private double amount;
    private Date txnDate;

    public Transaction(int from, int to, double amt) {
        this.fromAcc = from;
        this.toAcc = to;
        this.amount = amt;
        this.txnDate = new Date();
    }

    public Transaction() {}
}
import org.springframework.context.annotation.*;
import org.springframework.orm.hibernate5.LocalSessionFactoryBean;
import org.springframework.transaction.annotation.EnableTransactionManagement;
import org.springframework.jdbc.datasource.DriverManagerDataSource;

import javax.sql.DataSource;
import java.util.Properties;

@Configuration
@EnableTransactionManagement
@ComponentScan(basePackages = "com.bank")
public class AppConfig {

    @Bean
    public DataSource dataSource() {
        DriverManagerDataSource ds = new DriverManagerDataSource();
        ds.setUrl("jdbc:mysql://localhost:3306/yourdb");
        ds.setUsername("root");
        ds.setPassword("yourpassword");
        ds.setDriverClassName("com.mysql.cj.jdbc.Driver");
        return ds;
    }

    @Bean
    public LocalSessionFactoryBean sessionFactory() {
        LocalSessionFactoryBean sf = new LocalSessionFactoryBean();
        sf.setDataSource(dataSource());
        sf.setPackagesToScan("com.bank");
        Properties props = new Properties();
        props.put("hibernate.dialect", "org.hibernate.dialect.MySQL8Dialect");
        props.put("hibernate.hbm2ddl.auto", "update");
        sf.setHibernateProperties(props);
        return sf;
    }

    @Bean
    public org.springframework.orm.hibernate5.HibernateTransactionManager txManager() {
        return new org.springframework.orm.hibernate5.HibernateTransactionManager(sessionFactory().getObject());
    }
}
package com.bank;

import org.hibernate.SessionFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class BankingService {
    @Autowired
    SessionFactory sessionFactory;

    @Transactional
    public void transferMoney(int from, int to, double amount) {
        var session = sessionFactory.getCurrentSession();
        Account a1 = session.get(Account.class, from);
        Account a2 = session.get(Account.class, to);

        if (a1 == null || a2 == null || a1.getBalance() < amount) {
            throw new RuntimeException("Transfer Failed.");
        }

        a1.setBalance(a1.getBalance() - amount);
        a2.setBalance(a2.getBalance() + amount);
        session.save(new Transaction(from, to, amount));
    }
}
import org.springframework.context.annotation.AnnotationConfigApplicationContext;
import com.bank.BankingService;

public class AppMain {
    public static void main(String[] args) {
        var context = new AnnotationConfigApplicationContext(AppConfig.class);
        BankingService service = context.getBean(BankingService.class);

        try {
            service.transferMoney(1001, 1002, 5000);
            System.out.println("Transaction Successful.");
        } catch (Exception e) {
            System.out.println("Transaction Failed: " + e.getMessage());
        }

        context.close();
    }
}
